FROM ubuntu:24.04

# Image version, passed in by the Deploy taskfile
ARG VERSION=dev

LABEL maintainer="breitung.michael@gmail.com"
LABEL version="${VERSION}"
LABEL description="Base image for building static homepages (PHP, Node, gulp, Lighthouse, Chrome)."

ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]

ENV NVM_DIR=/usr/local/nvm
ENV NVM_VERSION=v0.40.8
ENV NODE_VERSION=v24.21.0
ENV TASK_VERSION=v3.54.0
ENV GULP_CLI_VERSION=3.1.0
ENV LIGHTHOUSE_VERSION=13.5.0
ENV LHCI_VERSION=0.15.1
ENV CODEX_VERSION=0.160.0

# Ubuntu 24.04 marks the system Python as "externally managed" (PEP 668).
# This is a single-purpose container, so installing into the system Python is fine.
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# apt packages are intentionally not version-pinned: Ubuntu removes superseded versions
# from its mirrors. Reproducibility comes from the published, versioned image tags.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
  sudo \
  iputils-ping \
  git \
  git-lfs \
  python3 \
  python3-pip \
  python3-venv \
  python-is-python3 \
  ca-certificates \
  curl \
  openssh-client \
  wget \
  bc \
  jq \
  unzip \
  bash-completion \
  gpg \
  less \
  nano \
  libimage-exiftool-perl \
  php-cli \
  php-mbstring \
  php-curl && \
  apt-get clean -y && \
  rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir \
  pytest==9.1.1 \
  pytest-asyncio==1.4.0 \
  black==26.5.1 \
  isort==9.0.2 \
  mypy==2.4.0 \
  requests==2.34.2 \
  Jinja2==3.1.6 \
  sseclient==0.0.27

# Install Node using NVM, plus the global build and audit tools.
# NVM_DIR is made writable and nvm.sh is sourced in interactive shells, so that other
# Node versions can be installed and selected with nvm.
RUN mkdir -p $NVM_DIR && curl -fsSo- https://raw.githubusercontent.com/nvm-sh/nvm/${NVM_VERSION}/install.sh | bash && \
  source $NVM_DIR/nvm.sh && \
  nvm install "$NODE_VERSION" && \
  npm install -g gulp-cli@${GULP_CLI_VERSION} lighthouse@${LIGHTHOUSE_VERSION} @lhci/cli@${LHCI_VERSION} @openai/codex@${CODEX_VERSION} && \
  for bin in node npm npx gulp lighthouse lhci codex; do \
    ln -s $NVM_DIR/versions/node/$NODE_VERSION/bin/$bin /usr/local/bin/$bin; \
  done && \
  chmod -R a+rwX $NVM_DIR && \
  echo '[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"' >> /etc/bash.bashrc

# Install Taskfile, plus its bash completion (loaded on demand by bash-completion)
RUN sh -c "$(curl -fsSL https://taskfile.dev/install.sh)" -- -d -b /usr/local/bin ${TASK_VERSION} && \
  task --completion bash > /usr/share/bash-completion/completions/task

# Install Google Chrome stable (needed by Lighthouse).
# Google publishes Chrome for Linux amd64 only, so this image cannot be built for arm64.
RUN if [ "$(dpkg --print-architecture)" != "amd64" ]; then \
      echo "Error: this image is amd64 only (Google Chrome)." >&2; exit 1; \
    fi && \
  install -m 0755 -d /etc/apt/keyrings && \
  curl -fsSL https://dl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o /etc/apt/keyrings/google-chrome.gpg && \
  echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main" \
  > /etc/apt/sources.list.d/google-chrome.list && \
  apt-get update && apt-get install -y --no-install-recommends google-chrome-stable && \
  apt-get clean -y && \
  rm -rf /var/lib/apt/lists/*

# Install Docker CLI with the buildx and compose plugins.
# The engine itself is not needed: the host's Docker socket is mounted into the container.
RUN install -m 0755 -d /etc/apt/keyrings && \
  curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc && \
  chmod a+r /etc/apt/keyrings/docker.asc

RUN echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu \
  $(. /etc/os-release && echo $VERSION_CODENAME) stable" | \
  tee /etc/apt/sources.list.d/docker.list > /dev/null
RUN apt-get update && apt-get install -y --no-install-recommends \
  docker-ce-cli \
  docker-buildx-plugin \
  docker-compose-plugin && \
  apt-get clean -y && \
  rm -rf /var/lib/apt/lists/*

# Install PHP Composer (installer verified against the published signature)
RUN EXPECTED_SIG="$(curl -fsSL https://composer.github.io/installer.sig)" && \
  curl -fsSL -o composer-setup.php https://getcomposer.org/installer && \
  echo "${EXPECTED_SIG}  composer-setup.php" | sha384sum --check && \
  php composer-setup.php --2 --install-dir=/usr/local/bin --filename=composer && \
  rm composer-setup.php

# Install Stripe CLI
RUN curl -fsSL https://packages.stripe.dev/api/security/keypair/stripe-cli-gpg/public | gpg --dearmor -o /usr/share/keyrings/stripe.gpg && \
  echo "deb [signed-by=/usr/share/keyrings/stripe.gpg] https://packages.stripe.dev/stripe-cli-debian-local stable main" \
  > /etc/apt/sources.list.d/stripe.list && \
  apt-get update && apt-get install -y --no-install-recommends stripe && \
  apt-get clean -y && \
  rm -rf /var/lib/apt/lists/*

# Install GitHub CLI (official apt repository)
RUN install -m 0755 -d /etc/apt/keyrings && \
  curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
  chmod a+r /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
  > /etc/apt/sources.list.d/github-cli.list && \
  apt-get update && apt-get install -y --no-install-recommends gh && \
  apt-get clean -y && \
  rm -rf /var/lib/apt/lists/*
